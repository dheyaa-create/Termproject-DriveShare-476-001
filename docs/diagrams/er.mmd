erDiagram
  users ||--|{ security_questions : "sets 3"
  users ||--o{ cars : owns
  cars ||--o{ car_availability : "offered in"
  cars ||--o{ bookings : "booked via"
  users ||--o{ bookings : rents
  bookings ||--o| payments : "paid by"
  users ||--o{ watches : watches
  cars ||--o{ watches : "watched by"
  users ||--o{ notifications : receives
  users ||--o{ messages : sends
  users ||--o{ messages : receives
  bookings ||--o{ reviews : "reviewed in"
  users ||--o{ reviews : "writes / receives"
  users { int id PK
    text email UK
    text name
    text password_hash
    real balance
    int failed_recovery
    text created_at }
  security_questions { int id PK
    int user_id FK
    int position "1..3"
    text question
    text answer_hash }
  cars { int id PK
    int owner_id FK
    text make
    text model
    int year
    int mileage
    text location
    real price_per_day
    text car_type "optional"
    int seats "optional"
    text transmission "optional"
    text fuel_type "optional"
    text features "optional"
    text description "optional"
    int is_active }
  car_availability { int id PK
    int car_id FK
    text start_time
    text end_time }
  bookings { int id PK
    int car_id FK
    int renter_id FK
    text start_time
    text end_time
    real total_price
    text status
    text created_at }
  payments { int id PK
    int booking_id FK "unique"
    int payer_id FK
    int payee_id FK
    real amount
    text reference }
  watches { int id PK
    int renter_id FK
    int car_id FK
    real max_price
    text start_time
    text end_time
    int active
    text last_notified }
  notifications { int id PK
    int user_id FK
    text kind
    text message
    text link
    int is_read }
  messages { int id PK
    int sender_id FK
    int recipient_id FK
    int car_id FK
    text body
    int is_read }
  reviews { int id PK
    int booking_id FK
    int reviewer_id FK
    int reviewee_id FK
    int rating "1..5"
    text comment }
